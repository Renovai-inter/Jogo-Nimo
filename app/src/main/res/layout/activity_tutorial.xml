<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tutorial_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.nimo.game.ui.SceneView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/tutorial_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/tutorial_title"
                    android:textColor="@color/pink"
                    android:textSize="30sp" />

                <com.nimo.game.ui.TiltDemoView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    style="@style/TutorialText"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/tutorial_tilt" />

                <TextView
                    android:id="@+id/tutorial_no_sensor"
                    style="@style/TutorialText"
                    android:text="@string/tutorial_no_sensor"
                    android:textColor="@color/orange_dark"
                    android:visibility="gone" />

                <TextView
                    style="@style/SectionHeader"
                    android:background="@drawable/bg_header_correct"
                    android:drawableStart="@drawable/ic_badge_check"
                    android:text="@string/tutorial_correct_title" />

                <LinearLayout
                    android:id="@+id/row_correct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/TutorialText"
                    android:text="@string/tutorial_correct_desc" />

                <TextView
                    style="@style/SectionHeader"
                    android:background="@drawable/bg_header_wrong"
                    android:drawableStart="@drawable/ic_badge_x"
                    android:text="@string/tutorial_wrong_title" />

                <LinearLayout
                    android:id="@+id/row_wrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/TutorialText"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/tutorial_wrong_desc"
                    android:textColor="@color/red"
                    android:textSize="19sp" />

                <TextView
                    style="@style/TutorialText"
                    android:layout_marginTop="14dp"
                    android:text="@string/tutorial_floor_rule" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_badge_x" />

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_badge_x" />

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_badge_x" />
                </LinearLayout>

                <TextView
                    style="@style/TutorialText"
                    android:text="@string/tutorial_errors_rule" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_start"
                style="@style/NimoButton.Green"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="@string/btn_start" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
